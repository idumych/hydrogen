# haiku-app.env — what the beos-app-platforms release tools need to know about this app.
# Shell syntax: sourced by packaging/*.sh, the CI workflow and the
# release scripts (check-artifact.sh, release-gate.sh). Keep values quoted; no spaces around '='.

# ── Identity ──
APP_NAME="Hydrogen"
APP_CMD="hydrogen"                     # same package name as HaikuPorts' Qt build, which
                                       # it replaces (both install apps/Hydrogen, bin/hydrogen)
APP_SIG="application/x-vnd.hydrogen"   # HaikuPorts' signature, so associations carry over
RDEF="src/haiku/Hydrogen.rdef"

PLATFORMS="haiku"                      # Linux has upstream's own Qt Hydrogen; this port's
                                       # audio and MIDI go through the Media Kit and Midi Kit
APP_PATH="apps/Hydrogen"
DESKBAR_NAME="Hydrogen"

# ── Version (also in the .rdef app_version) ──
VERSION="2.0.0"
REVISION="1"

# ── Package metadata ──
SUMMARY="Advanced drum machine and pattern sequencer"
DESCRIPTION_FILE="packaging/description.txt"
HOMEPAGE="https://github.com/idumych/hydrogen"
GITHUB_REPO="idumych/hydrogen"
LICENSE_NAME="GNU GPL v2"
COPYRIGHT="2002-2026 The hydrogen development team; Haiku port 2026 idumych"
PACKAGER="idumych <19998719+idumych@users.noreply.github.com>"

# Extra runtime dependencies beyond the Haiku API itself
HPKG_REQUIRES_EXTRA="lib:libqt5core lib:libqt5gui lib:libqt5xml lib:libqt5network lib:libqt5test lib:libsndfile lib:libarchive lib:libz"
DESKTOP_CATEGORIES="AudioVideo;Audio;Music;"
APPIMAGE_MUST_BUNDLE=""
APPIMAGE_FONTS_EXTRA=""
APPIMAGE_TRANSLATORS=""
COSMOE_REPO=""
COSMOE_TAG=""
SMOKE_ARGS=""
SMOKE_WINDOW=""
SMOKE_PROCESS=""
APPIMAGE_APT_EXTRA=""

# ── Build ──
HPKG_BUILD_DEPS="cmake qt5_devel qt5_tools libsndfile_devel libarchive_devel zlib_devel ladspa_sdk_devel cppunit_devel"
TEST_CMD=""                            # the core's CppUnit suite needs Qt Svg and Linguist,
                                       # which this host lacks; build-hpkg.sh runs it on Haiku
TYPECHECK_SRCS="src/haiku/*.cpp"
TYPECHECK_INCLUDES="src tools/typecheck .haiku-headers/haiku/headers/private/interface"
                                           # tools/typecheck: core/config.h, the generated
                                           # one of a Haiku build, and ladspa.h from
                                           # ladspa_sdk_devel; private/interface: the
                                           # build adds it for BDecimalSpinner, ToolTip.h
TYPECHECK_CXXFLAGS="-D__HAIKU__ -fPIC $(pkg-config --cflags Qt5Core Qt5Xml Qt5Gui 2>/dev/null || :)"

# ── Feature test (the app-specific part of release/test-plan.md) ──
FEATURE_CHECKS="play export"
EVIDENCE_1="{p}-play.txt|peak -?[0-9.]+ dBFS, ok"
EVIDENCE_2="{p}-export.txt|RIFF .*WAVE audio"
